<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>MyRiverbend Admin — Patient</title>
  <link rel="stylesheet" href="/css/portal.css">
  <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
</head>
<body>
  <nav class="topnav">
    <a href="/admin">Patient Lookup</a>
    <a href="/logout">Sign out</a>
  </nav>
  <div class="wrap">
    <h1>Patient Detail</h1>
    <table class="detail">
      <%
        var labels = { dob: 'Date of Birth', addr_line1: 'Address Line 1', patient_id: 'Patient ID', updated_at: 'Updated At', family: 'Family', given: 'Given', name: 'Name' };
        function pretty(key) {
          if (labels[key]) return labels[key];
          return key.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
        }
        function formatValue(key, value) {
          if (value == null) return '';
          if (Array.isArray(value)) {
            if (key === 'given') return value.join(' ');
            if (key === 'identifier') {
              var parts = [];
              var i;
              for (i = 0; i < value.length; i++) {
                if (value[i] && value[i].value) parts.push(value[i].value);
              }
              return parts.join(', ');
            }
            return value.join(', ');
          }
          if (typeof value === 'object') {
            if (value.value) return value.value;
            return '';
          }
          return value;
        }
        if (patient) {
          Object.keys(patient).forEach(function (key) {
            if (key === 'ssn') return;
      %>
      <tr>
        <th><%= pretty(key) %></th>
        <td><%= formatValue(key, patient[key]) %></td>
      </tr>
      <%
          });
        }
      %>
    </table>
  </div>
  <script src="/js/portal.js"></script>
</body>
</html>
