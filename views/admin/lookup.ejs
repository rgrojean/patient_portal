<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>MyRiverbend Admin — Lookup</title>
  <link rel="stylesheet" href="/css/portal.css">
  <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
</head>
<body>
  <nav class="topnav">
    <a href="/admin">Patient Lookup</a>
    <a href="/logout">Sign out</a>
  </nav>
  <div class="wrap">
    <h1>Patient Lookup</h1>
    <form method="get" action="/admin/search" id="lookup-form">
      <label>Name <input type="text" name="name" value="<%= q.name || '' %>"></label>
      <label>DOB <input type="text" name="dob" placeholder="MM/DD/YYYY" value="<%= q.dob || '' %>"></label>
      <button type="submit">Search</button>
    </form>
    <% if (results) { %>
      <table class="detail">
        <tr><th>Patient ID</th><th>Name</th><th>DOB</th><th></th></tr>
        <% results.forEach(function (r) { %>
          <tr>
            <td><%= r.patient_id %></td>
            <td><%= r.name %></td>
            <td><%= r.dob %></td>
            <td><a href="/admin/patients/<%= r.patient_id %>">View</a></td>
          </tr>
        <% }); %>
      </table>
    <% } %>
  </div>
  <script src="/js/portal.js"></script>
</body>
</html>
