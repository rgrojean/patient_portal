<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>MyRiverbend — Profile</title>
  <link rel="stylesheet" href="/css/portal.css">
  <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="wrap">
    <h1>My Profile</h1>
    <table class="detail">
      <%
        var labels = { dob: 'Date of Birth', addr_line1: 'Address Line 1', patient_id: 'Patient ID', updated_at: 'Updated At' };
        function pretty(key) {
          if (labels[key]) return labels[key];
          return key.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
        }
        if (patient) {
          Object.keys(patient).forEach(function (key) {
      %>
      <tr>
        <th><%= pretty(key) %></th>
        <td><%= patient[key] %></td>
      </tr>
      <%
          });
        }
      %>
    </table>
  </div>
  <script src="/js/portal.js"></script>
</body>
</html>
